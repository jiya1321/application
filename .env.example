# Krishna Electronics Environment Variables
# Note: None of these are strictly required for the frontend or demo backend to function.

# Node environment ('development' locally, 'production' on Vercel)
NODE_ENV=production

# Local development port (default: 5000)
PORT=5000

# Optional: PostgreSQL connection URL (only required if provisioning an external database with Drizzle Kit)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
